# ============================================
# 静记 前端环境变量模板
# 复制为 .env.development / .env.production 后填入实际值
# ============================================

# ---- API 地址 ----
# 本地开发：直连后端
# VITE_API_BASE_URL=http://localhost:3000/api
# 生产构建：同源子路径（Nginx /bookkeeping/api → NestJS /api）
# VITE_API_BASE_URL=/bookkeeping/api
VITE_API_BASE_URL=http://localhost:3000/api

# ---- 静态资源 base 路径（可选，默认 dev=/ production=/bookkeeping/）----
# VITE_BASE=/

# ---- 高德地图（地图功能需要） ----
VITE_AMAP_KEY=your-amap-key
VITE_AMAP_SECRET=your-amap-secret
