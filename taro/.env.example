# ============================================
# 财猫家庭记账 Taro 小程序环境变量模板
# 复制为 .env.development / .env.production 后填入实际值
# ============================================

# ---- API 地址 ----
TARO_APP_API_BASE_URL=http://localhost:3000/api
# 真机调试请改成电脑局域网 IP，例如：
# TARO_APP_API_BASE_URL=http://192.168.0.112:3000/api