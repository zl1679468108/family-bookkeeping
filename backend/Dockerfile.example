# 使用多阶段构建，第一阶段用于编译构建
FROM node:20 AS builder

# 设置工作目录
WORKDIR /app

# 复制 package.json 和 package-lock.json
COPY package*.json ./

# 安装所有依赖（包括开发依赖）
RUN npm install

# 复制项目所有文件
COPY . .

# 执行生产环境构建
RUN npm run build:prod

# 第二阶段：运行阶段，只保留必要的运行时依赖
FROM node:20

# 设置工作目录
WORKDIR /app

# 复制 package.json 和 package-lock.json
COPY package*.json ./

# 只安装生产依赖
RUN npm install --production

# 从构建阶段复制编译后的代码
COPY --from=builder /app/dist ./dist

# 暴露端口
EXPOSE 3000

# 生产环境变量（请在 CloudBase Run 控制台中配置或通过部署脚本注入）
# 方式 1：在 CloudBase Run 控制台中配置环境变量（推荐）
# 方式 2：复制 .env.production 并在启动时设置 NODE_ENV=production
#   COPY .env.production ./.env.production
#   CMD ["sh", "-c", "NODE_ENV=production node dist/main.js"]

# 启动应用
CMD ["node", "dist/main.js"]
