# ============================================
# 静记 后端环境变量模板
# 复制为 .env.development / .env.production 后填入实际值
# ============================================

# ---- Supabase 数据库 ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- 服务配置 ----
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# ---- CORS（逗号分隔，未设置时使用默认值） ----
# CORS_ORIGINS=http://localhost:3001,https://your-domain.com

# ---- 邮件服务（可选，不配置时邮件功能降级为静默跳过） ----
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@qq.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=your-email@qq.com

# ---- 微信小程序（可选，用于 UGC 内容安全检测，审核必接） ----
# WECHAT_MSG_SEC_CHECK_ENABLED=true 时启用 msg_sec_check 文本检测
# 未配置或为 false 时，UGC 接口跳过检测（本地开发友好）
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret
WECHAT_MSG_SEC_CHECK_ENABLED=false